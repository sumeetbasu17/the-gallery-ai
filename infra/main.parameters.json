{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=eastus}" },
    "foundryResourceName": { "value": "${FOUNDRY_RESOURCE_NAME=gallery-foundry-sb}" },
    "foundryProjectName": { "value": "${FOUNDRY_PROJECT_NAME=the-gallery}" },
    "fastModel": { "value": "${GALLERY_FAST_MODEL=gpt-5.4-mini}" },
    "creativeModel": { "value": "${GALLERY_CREATIVE_MODEL=gpt-5.4-mini}" },
    "webImageName": { "value": "${SERVICE_WEB_IMAGE_NAME=}" }
  }
}
