# Copy to .env and adjust. No secrets here: auth is keyless via `az login`.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>
GALLERY_FAST_MODEL=gpt-5.4-mini
GALLERY_CREATIVE_MODEL=gpt-5.4-mini
GALLERY_LANGUAGES=en,hi,es
# GALLERY_MODE=foundry | openai | offline (auto-detected if unset)
